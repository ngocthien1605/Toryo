# D365FO machine config (M9-C1, M12-18) — %USERPROFILE%\.toryo\toryo.local.yaml on the UDE machine,
# outside every repository. The ONLY place for agent profiles, the X++ toolchain and the commands of
# environment gates (R59/R60). It loads together with toryo.orgchart.yaml.example and the
# .toryo/ folder of this template.
# Merge it with what the file already holds (one `profiles:`, one `seats:`, one `git:`).
#
# TODO(owner):
#   1. profiles.*.exe — where claude.exe and codex.exe are installed on this machine.
#   2. claude-foundry / codex-foundry — only on a machine that uses Foundry: the Foundry resource,
#      the deployment names, the base_url. Delete the two profiles on a machine that does not.
#   3. secret_env — the Credential Manager targets (`toryo secrets set toryo/<name>`).
#   4. codex-foundry.env.CODEX_HOME — a folder of its own (auth and sessions only), written out in
#      full: a `%NAME%` in an `env:` value is NOT expanded (`toryo doctor` warns).
#   5. toolchains.xpp.msbuild — `toryo doctor` proposes the path vswhere finds.
#   6. toolchains.xpp.nugets — the five CI/CD NuGets for the release the UDE runs, extracted.
#   7. toolchains.xpp.ude_metadata — the UDE's PackagesLocalDirectory (version check only).
#   8. seats — which Claude profile plans and reviews on this machine (the org chart seats
#      claude-max for both, codex-openai for the implementer).
#   9. git.trusted_filters — only if the repository uses Git LFS (Open decision 14).
#  10. environment_gates.dbsync — copy templates/d365fo/machine/dbsync.ps1.example OUTSIDE every
#      repository and point `args` at it; put your real deploy and sync into it.
#  11. verify.verify_root — a SHORT folder on a drive with room (Windows tools stop at 260
#      characters; `toryo doctor` prints the length). It replaces the repository's.
profiles:
  claude-max:                               # personal machine: Claude Max subscription
    kind: claude
    billing: subscription
    exe: C:\Users\<you>\.local\bin\claude.exe            # TODO(owner) 1
    version: "2.1.x"
    env:
      CLAUDE_CODE_GIT_BASH_PATH: C:\Program Files\Git\bin\bash.exe

  codex-openai:                             # personal machine: ChatGPT login (the org chart's implementer)
    kind: codex
    billing: subscription
    exe: C:\tools\codex\codex.exe                        # TODO(owner) 1
    codex:
      sandbox_mode: workspace-write
      windows_sandbox: unelevated                        # R18: without it the Windows sandbox is OFF

  claude-foundry:                           # company laptop: approved Foundry models
    kind: claude
    billing: foundry
    # `toryo usage` prices it by its model: set `model: <deployment>` (as named in prices.toml) —
    # a Claude implementer runs with, and records, the profile's model only (M10-R3)
    exe: C:\Users\<you>\.local\bin\claude.exe            # TODO(owner) 1
    version: "2.1.x"
    env:
      CLAUDE_CODE_USE_FOUNDRY: "1"
      ANTHROPIC_FOUNDRY_RESOURCE: my-foundry             # TODO(owner) 2
      ANTHROPIC_DEFAULT_OPUS_MODEL: claude-opus-5-5      # TODO(owner) 2
      CLAUDE_CODE_GIT_BASH_PATH: C:\Program Files\Git\bin\bash.exe
    secret_env:
      ANTHROPIC_FOUNDRY_API_KEY: credman:toryo/foundry-claude   # TODO(owner) 3

  codex-foundry:                            # company laptop: the implementer on Foundry
    kind: codex
    billing: foundry
    exe: C:\tools\codex\codex.exe                        # TODO(owner) 1
    model: gpt-5-codex                                   # TODO(owner) 2: the deployment name
    env:
      CODEX_HOME: C:\Users\<you>\.toryo\codex-home       # TODO(owner) 4
    secret_env:
      AZURE_OPENAI_API_KEY: credman:toryo/foundry-openai # TODO(owner) 3
    codex:
      sandbox_mode: workspace-write
      windows_sandbox: unelevated                        # R18: without it the Windows sandbox is OFF
      provider:
        id: foundry
        name: Azure Foundry
        base_url: https://my-foundry.openai.azure.com/openai/v1   # TODO(owner) 2
        env_key: AZURE_OPENAI_API_KEY
        wire_api: responses

toolchains:
  xpp:
    msbuild: 'C:\Program Files\Microsoft Visual Studio\2022\Professional\MSBuild\Current\Bin\MSBuild.exe'   # TODO(owner) 5
    nugets: 'D:\D365\cicd-nugets\10.0.45'                # TODO(owner) 6
    extra_references: []                                 # folders of binary packages the models reference (ISV)
    bp_check: false                                      # xppbp.exe: not supported yet (V08-VERIFY 4)
    ude_metadata: '%LOCALAPPDATA%\Microsoft\Dynamics365\10.0.2345.12\PackagesLocalDirectory'   # TODO(owner) 7

seats:                                      # TODO(owner) 8 — override the org chart's seats on this machine
  planner:  { profile: claude-max, model: opus }
  reviewer: { profile: claude-max, model: opus }
  # company laptop: the implementer on Foundry
  # implementer: { profile: codex-foundry }

git:
  trusted_filters: {}                       # TODO(owner) 9 — with Git LFS:
  #   lfs:
  #     process: '"C:\Program Files\Git LFS\git-lfs.exe" filter-process'
  #     required: true

# This machine's floor for the repositories' verify sandbox, and its verify root (M11, review H2).
# `min_boundary: low_integrity` refuses a repository that asks for `boundary: none`.
verify:
  min_boundary: low_integrity
  verify_root: 'D:\toryo-verify'            # TODO(owner) 11

# The environment gate the org chart's `dbsync` gate runs on this machine (M11-E3). Without this
# entry `task create` refuses the org chart (`if_missing: error`); a machine without a D365FO
# environment sets `if_missing: skip` on the gate in toryo-orgchart.yaml instead.
# (After `environment_gate_unavailable`: a secret or program added on the machine → `toryo resume
# <id>`; this entry changed → `toryo task config <id> --reload`, then `toryo resume <id>`.)
environment_gates:
  dbsync:
    program: powershell                     # Windows PowerShell 5.1; pwsh for 7
    args: [-NoProfile, -NonInteractive, -File, 'C:\toryo-gates\dbsync.ps1']   # TODO(owner) 10 — outside every repository
    lock: d365-env
    confirm: first                          # stop and ask before the first deploy of each task
    # env:    { D365_PACKAGES: 'K:\AosService\PackagesLocalDirectory' }
    # secret_env: { D365_SYNC_SECRET: 'credman:toryo/d365-sync' }

# M10: a Windows toast when a task needs you (a gate, an escalation, a pause, the end of a run).
# Off by default; `toryo notify-test` shows a sample.
# notify:
#   toast: true

# M11: the shared skills folder of this machine (org chart skills are looked up in the repository
# first, then here).
# skills_dir: C:/Temp/AgentShare/skills

# The full comments and the contract of a gate script are in templates/toryo.local.yaml.example and
# in the header of templates/d365fo/machine/dbsync.ps1.example.
