# thien.yaml for the M0 spike — copy to a working folder (e.g. C:\.thien\m0\thien.yaml) and edit paths.
# No secrets in this file. Secrets: `thien secrets set thien/<name>` (Windows Credential Manager).
version: 1
project:
  root: C:\.thien\m0\calc                 # created by: thien spike init-fixture --into C:\.thien\m0\calc
  worktrees_root: C:\.thien\m0\worktrees
  runs_root: '%LOCALAPPDATA%\thien\runs'
  base_branch: main

profiles:
  claude-max:                              # personal machine: Claude Max subscription
    kind: claude
    billing: subscription                  # R30: every Claude profile runs --restricted --safe-mode
    exe: C:\Users\thien\.local\bin\claude.exe
    version: "2.1.x"                       # doctor: needs >= 2.1.259 (--permission-prompts), >= 2.1.248 (--restricted)
    env:
      CLAUDE_CODE_GIT_BASH_PATH: C:\Program Files\Git\bin\bash.exe
    # secret_env:                          # optional; omit to use the interactive /login of this Windows user
    #   CLAUDE_CODE_OAUTH_TOKEN: credman:thien/claude-max-oauth

  claude-foundry:                          # company laptop only
    kind: claude
    billing: foundry
    exe: C:\Users\thien\.local\bin\claude.exe
    env:
      CLAUDE_CODE_USE_FOUNDRY: "1"
      ANTHROPIC_FOUNDRY_RESOURCE: my-foundry
      CLAUDE_CODE_GIT_BASH_PATH: C:\Program Files\Git\bin\bash.exe
    secret_env:
      ANTHROPIC_FOUNDRY_API_KEY: credman:thien/foundry-claude

  codex-foundry:
    kind: codex
    billing: foundry
    exe: C:\tools\codex\codex.exe          # or the npm shim, e.g. %APPDATA%\npm\codex.cmd
    model: gpt-5-codex                     # your Foundry deployment name
    env:
      CODEX_HOME: C:\Users\thien\.thien\codex-home   # auth + sessions only; config.toml there is ignored
    secret_env:
      AZURE_OPENAI_API_KEY: credman:thien/foundry-openai
    codex:
      sandbox_mode: workspace-write
      windows_sandbox: unelevated          # R18: WITHOUT THIS THE WINDOWS SANDBOX IS OFF
      model_reasoning_effort: medium
      provider:
        id: foundry
        name: Azure Foundry
        base_url: https://my-foundry.openai.azure.com/openai/v1
        env_key: AZURE_OPENAI_API_KEY
        wire_api: responses

roles:
  planner:     { profile: claude-max, model: opus }
  implementer: { profile: codex-foundry }
  reviewer:    { profile: claude-max, model: opus }

policy:
  deny_paths: ["**/ZZZ/**", "**/*.pfx", "**/.env*"]
  protected_paths: ["@verify-scripts", "thien.yaml", ".thien/**", "AGENTS.md", "CLAUDE.md", ".claude/**", ".codex/**", ".mcp.json", ".gitattributes", ".githooks/**", "thien.local.yaml", ".gitmodules"]
  neutralize_untrusted_filters: false
  allow_submodules: false
  allow_codex_project_config: false

verify:
  checkout: clean
  boundary: low_integrity
  verify_root: '%LOCALAPPDATA%\thien-verify'
  final_clean: true

commands:
  verify:
    - { name: build, program: pwsh, args: ["-NoProfile", "-File", "scripts/build.ps1"], timeout_min: 10 }
    - { name: test,  program: pwsh, args: ["-NoProfile", "-File", "scripts/test.ps1"],  timeout_min: 10 }

timeouts:
  agent_stall_min: 10
  agent_stage_max_min: 60
