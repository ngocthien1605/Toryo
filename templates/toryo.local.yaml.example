# Machine config — lives OUTSIDE every repository: %USERPROFILE%\.toryo\toryo.local.yaml (R35/R37).
# The ONLY place for agent profiles (R60), the role overrides of this machine, and the ONLY
# trusted Git filter commands (R37).
profiles:                                  # R60: never in the repository's toryo.yaml
  claude-max:                              # personal machine: Claude Max subscription
    kind: claude
    billing: subscription                  # R30: every Claude profile runs --restricted --safe-mode
    exe: C:\Users\toryo\.local\bin\claude.exe
    version: "2.1.x"                       # doctor: needs >= 2.1.259 (--permission-prompts), >= 2.1.248 (--restricted)
    env:
      CLAUDE_CODE_GIT_BASH_PATH: C:\Program Files\Git\bin\bash.exe
    # secret_env:                          # optional; omit to use the interactive /login of this Windows user
    #   CLAUDE_CODE_OAUTH_TOKEN: credman:toryo/claude-max-oauth

  claude-foundry:                          # company laptop only
    kind: claude
    billing: foundry
    # `toryo usage` prices it by its model: set `model: <deployment>` (as named in prices.toml) —
    # a Claude implementer runs with, and records, the profile's model only (M10-R3)
    exe: C:\Users\toryo\.local\bin\claude.exe
    env:
      CLAUDE_CODE_USE_FOUNDRY: "1"
      ANTHROPIC_FOUNDRY_RESOURCE: my-foundry
      CLAUDE_CODE_GIT_BASH_PATH: C:\Program Files\Git\bin\bash.exe
    secret_env:
      ANTHROPIC_FOUNDRY_API_KEY: credman:toryo/foundry-claude

  codex-foundry:
    kind: codex
    billing: foundry
    exe: C:\tools\codex\codex.exe          # or the npm shim, e.g. %APPDATA%\npm\codex.cmd
    model: gpt-5-codex                     # your Foundry deployment name
    env:
      CODEX_HOME: C:\Users\<you>\.toryo\codex-home   # auth + sessions only; config.toml there is ignored
    secret_env:
      AZURE_OPENAI_API_KEY: credman:toryo/foundry-openai
    codex:
      sandbox_mode: workspace-write
      windows_sandbox: unelevated          # R18: WITHOUT THIS THE WINDOWS SANDBOX IS OFF
      model_reasoning_effort: medium
      provider:
        id: foundry
        name: Azure Foundry
        base_url: https://my-foundry.openai.azure.com/openai/v1
        env_key: AZURE_OPENAI_API_KEY
        wire_api: responses

# toolchains:                              # R59/R60: machine facts for `tool:` verify commands; never in the repository
#   xpp:                                   # X++ (D365FO) on the UDE machine — see templates/d365fo/
#     msbuild: 'C:\Program Files\Microsoft Visual Studio\2022\Professional\MSBuild\Current\Bin\MSBuild.exe'
#     nugets: 'D:\D365\cicd-nugets\<release>'   # the five CI/CD NuGet packages, extracted (one folder each)
#     extra_references: []                 # folders of binary packages the models reference (e.g. ISV)
#     bp_check: false                      # `true` is refused until xppbp.exe is supported
#     ude_metadata: '%LOCALAPPDATA%\Microsoft\Dynamics365\<ApplicationVersion>\PackagesLocalDirectory'   # doctor only

roles:
  planner:  { profile: claude-max, model: opus }
  reviewer: { profile: claude-max, model: opus }
git:
  trusted_filters:
    # M0 finding F1: a trusted driver MUST define `process` — Git prefers a non-empty `process`
    # over clean/smudge, and `-c` cannot unset the repo's own `process`. git-lfs is a process driver.
    lfs:
      process: '"C:/Program Files/Git LFS/git-lfs.exe" filter-process'
      required: true

# M10: a Windows toast when a task needs you — a gate opens, it escalates or pauses, a run ends
# Completed or Failed. Default off; `toryo run|resume|approve --continue` take --notify / --no-notify.
# A machine setting: not frozen with a task, not hashed. Check it with `toryo notify-test`.
# notify:
#   toast: true

# M11 — the org chart (.toryo/toryo-orgchart.yaml in a repository). `seats:` is the new spelling
# of `roles:` (same fields; one of the two per file): a seat set here replaces the repository's
# seat on this machine, and `toryo config show` marks it "repo, overridden by machine".
# seats:
#   planner:  { profile: claude-foundry, model: opus }
#   reviewer: { profile: claude-foundry, model: opus }

# M11 — this machine's shared skills folder: <skills_dir>/<name>/SKILL.md, looked up AFTER the
# repository's .toryo/skills/<name>/. Only SKILL.md is delivered (the files next to it are
# readable only for repository skills). Forward slashes work on Windows. Absolute, and outside
# the repository, the task worktrees and the verify root (its text is trusted); `toryo doctor`
# warns when the folder does not exist.
# skills_dir: C:/Temp/AgentShare/skills

# M11 — environment gates: what an org chart's `kind: environment` gate runs, with YOUR normal
# rights, so it lives only here. `program`: an absolute path or a PATH name; every path in `args`
# absolute and outside the repository, the task worktrees and the verify root (validated).
# %VAR% in `program`/`args` is expanded ONCE, when the config is loaded (`task create`): the
# expanded text is what is checked, frozen and run (`toryo config show` prints it); an unset
# variable is a load error. A PATH name that resolves inside those folders is refused at run time.
# Runs only after every `check` gate of the same verify run passed (a check gate that changed a
# tracked file of the checkout stops it: verify_mutated_tree). It never reads the verify checkout
# the check gates used: once it holds its lock, Toryo exports the checkpoint commit afresh from
# the repository's object store into a folder no agent code can write (`<verify_root>\<task>\deploy`)
# — that export is its TORYO_VERIFY_CHECKOUT. It runs in an EMPTY working directory agent code
# cannot write, inside a Job Object (the timeout of the org chart kills the whole tree), with an
# environment built from scratch + TORYO_TASK, TORYO_SHA, TORYO_VERIFY_CHECKOUT, TORYO_VERIFY_BUILD + `env` +
# the resolved `secret_env` (redacted from every log). One gate per `lock` runs at a time across
# all tasks; `toryo status` shows which task and commit each lock's environment last received.
# Lock names ignore case (D365-Env is d365-env); Windows device names (con, nul, com1, …) are
# refused. A gate killed by its timeout or a stop is recorded as interrupted (a partial deploy).
# What a gate needs from this machine — every `secret_env` value, its program, a valid lock name —
# is checked BEFORE the check gates run: a gate that cannot start stops the task at once
# (environment_gate_unavailable), not after a long build. The way on depends on the fix:
#   - a value added to Credential Manager, a program installed: `toryo resume <id>` (no fix cycle);
#   - this entry changed (program, args, env, a secret_env reference): a task that already exists
#     does not see it — its gate command is frozen with the task. `toryo task config <id> --reload`,
#     then `toryo resume <id>`.
# environment_gates:
#   dbsync:
#     program: powershell                 # Windows PowerShell 5.1; pwsh for 7
#     args: [-NoProfile, -NonInteractive, -File, 'C:\toryo-gates\dbsync.ps1']
#     lock: d365-env
#     env:
#       D365_PACKAGES: 'K:\AosService\PackagesLocalDirectory'
#     secret_env:
#       D365_SYNC_SECRET: credman:toryo/d365-sync
#
# The contract of a gate script (e.g. dbsync.ps1):
#   1. The exit code decides: 0 = pass, anything else = fail. PowerShell exits 0 even when a
#      native .exe failed, so start with `$ErrorActionPreference = 'Stop'` and after every native
#      call (SyncEngine.exe, msbuild.exe, …): `if ($LASTEXITCODE -ne 0) { exit $LASTEXITCODE }`.
#   2. Deploy what Toryo verified, nothing else: the source from $env:TORYO_VERIFY_CHECKOUT
#      (commit $env:TORYO_SHA) and/or the compiled package from $env:TORYO_VERIFY_BUILD — never
#      from your main repository folder.
#   3. Idempotent: Toryo runs it again in the next fix cycle and after a crash.
#   4. Print the useful error lines: the end of the output is what the implementer receives.
#   5. Never write into $env:TORYO_VERIFY_CHECKOUT (checked afterwards: verify_mutated_tree).
#   6. Never wait for input: with -NonInteractive a prompt fails at once instead of hanging.
#   (M11) The working directory is an empty folder — never rely on it: find the code through
#   $env:TORYO_VERIFY_CHECKOUT / $env:TORYO_VERIFY_BUILD, call every tool by its absolute path,
#   and do not run `git` there — use $env:TORYO_SHA.
#   (M11) TORYO_VERIFY_CHECKOUT — for an environment gate: a fresh copy of the commit that no
#   agent code could touch (no `.git`; checked after the gate: write nothing there).
#   TORYO_VERIFY_BUILD — written by the check gates at Low integrity. When a check gate runs
#   agent-written code (tests), treat this folder as untrusted and build again from
#   TORYO_VERIFY_CHECKOUT inside the script. Anything your script interprets from it (a .ps1 it
#   dot-sources, a project file msbuild reads, an .exe it starts) runs agent-written logic with
#   your full rights.

# M11 (review H2) — this machine's floor for the repositories' verify sandbox, and its verify
# root. A repository `verify.boundary: none` is refused unless `min_boundary: none` here (only
# for repositories whose code you trust). `verify_root` replaces the repository's.
# verify:
#   min_boundary: low_integrity
#   verify_root: '%LOCALAPPDATA%\toryo-verify'
