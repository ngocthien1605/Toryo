# toryo.yaml for the M0 spike — copy to a working folder (e.g. C:\.thien\m0\toryo.yaml) and edit paths.
# No secrets in this file. Secrets: `toryo secrets set toryo/<name>` (Windows Credential Manager).
version: 1
project:
  root: C:\.thien\m0\calc                 # created by: toryo spike init-fixture --into C:\.thien\m0\calc
  worktrees_root: C:\.thien\m0\worktrees
  runs_root: '%LOCALAPPDATA%\toryo\runs'
  base_branch: main

# R60: no `profiles:` here — agent profiles (exe, env, secrets, Codex settings) live only in the
# machine config, %USERPROFILE%\.toryo\toryo.local.yaml (see toryo.local.yaml.example).

roles:                                     # names of profiles the machine config defines (R60)
  planner:     { profile: claude-max, model: opus }
  implementer: { profile: codex-foundry }
  reviewer:    { profile: claude-max, model: opus }

policy:
  deny_paths: ["**/ZZZ/**", "**/*.pfx", "**/.env*"]
  protected_paths: ["@verify-scripts", "toryo.yaml", ".toryo/**", "AGENTS.md", "CLAUDE.md", ".claude/**", ".codex/**", ".mcp.json", ".gitattributes", ".githooks/**", "toryo.local.yaml", ".gitmodules"]
  neutralize_untrusted_filters: false
  allow_submodules: false
  allow_codex_project_config: false

verify:
  checkout: clean
  boundary: low_integrity
  verify_root: '%LOCALAPPDATA%\toryo-verify'
  final_clean: true

commands:
  verify:
    - { name: build, program: pwsh, args: ["-NoProfile", "-File", "scripts/build.ps1"], timeout_min: 10 }
    - { name: test,  program: pwsh, args: ["-NoProfile", "-File", "scripts/test.ps1"],  timeout_min: 10 }

timeouts:
  agent_stall_min: 10
  agent_stage_max_min: 60
