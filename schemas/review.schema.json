{
  "type": "object",
  "required": ["decision", "summary", "acceptance_criteria", "issues"],
  "properties": {
    "decision": { "enum": ["approved", "changes_requested", "blocked"] },
    "summary":  { "type": "string" },
    "acceptance_criteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "met", "evidence"],
        "properties": {
          "id":       { "type": "string", "pattern": "^AC-[1-9][0-9]*$" },
          "met":      { "type": "boolean" },
          "evidence": { "type": "string", "minLength": 1 }
        }
      }
    },
    "issues": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "severity", "description", "blocking"],
        "properties": {
          "id":          { "type": "string", "pattern": "^I-[1-9][0-9]*$" },
          "severity":    { "enum": ["high", "medium", "low"] },
          "blocking":    { "type": "boolean" },
          "file":        { "type": "string" },
          "line":        { "type": "integer" },
          "description": { "type": "string" }
        }
      }
    },
    "resolved_from_previous": { "type": "array", "items": { "type": "string" } }
  }
}
